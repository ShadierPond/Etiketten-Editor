<Window x:Class="FuniturenEditor.Desktop.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Druckvorschau" Height="850" Width="1120"
        MinHeight="600" MinWidth="800" WindowStartupLocation="CenterOwner"
        Background="#E8EEF4">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D8E0E8"
                BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentTitleText" FontSize="18" FontWeight="SemiBold"
                               Foreground="#172B42" />
                    <TextBlock Text="A4 · Vorschau des tatsächlichen Drucklayouts"
                               Foreground="#657586" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Abbrechen" IsCancel="True"
                        MinWidth="110" Margin="0,0,8,0" />
                <Button x:Name="ContinueButton" Grid.Column="2"
                        Content="Weiter zum Windows-Druckdialog"
                        MinWidth="230" IsDefault="True" Click="ContinueButton_Click" />
            </Grid>
        </Border>
        <DocumentViewer x:Name="PreviewViewer" Background="#E8EEF4"
                        Loaded="PreviewViewer_Loaded" />
    </DockPanel>
</Window>
