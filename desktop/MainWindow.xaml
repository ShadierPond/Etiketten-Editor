<Window x:Class="LabelEditor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Title="Etiketten Editor" Height="820" Width="1500"
        MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="#F2F5F8"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}" />
        <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#18344F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ResultBorder" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResultBorder" Property="Background" Value="#E8F1FA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ResultBorder" Property="Background" Value="#DCEBFF" />
                                <Setter Property="Foreground" Value="#123E68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8A98A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E0E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MaxHeight" Value="480" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="StaysOpen" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer MaxHeight="{TemplateBinding MaxHeight}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource ModernScrollBar}" />
                                </ScrollViewer.Resources>
                                <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#18344F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinWidth" Value="210" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#E8F1FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8A98A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactModernMenuItem" TargetType="MenuItem"
               BasedOn="{StaticResource ModernMenuItem}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#18344F" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF" CornerRadius="6" Padding="4" Margin="0,0,14,0">
                        <Image Source="pack://application:,,,/assets/EtikettenEditor.ico" Width="30" Height="30"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Etiketten Editor" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Lokaler Arbeitsbereich" Foreground="#B8C7D6" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Column="1" Margin="20,0,0,0"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              PanningMode="HorizontalOnly"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hilfe" Click="Help_Click" ToolTip="Anleitung durchsuchen und Themen Schritt für Schritt ansehen" />
                        <Button x:Name="CatalogActionsButton" Click="ShowActionMenu_Click"
                                ToolTip="Aktuelle Liste oder ganzen Katalog drucken">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <svgc:SvgViewbox Width="16" Height="16" Margin="0,0,7,0"
                                                      Source="/assets/icons/print-icon.svg" />
                                    <TextBlock Text="Drucken ▾" />
                                </StackPanel>
                            </Button.Content>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenu}" Closed="ActionMenu_Closed">
                                    <MenuItem Style="{StaticResource ModernMenuItem}" Header="Aktuelle Liste"
                                              ToolTip="Nur die ausgewählte Liste drucken" Click="PrintCurrent_Click" />
                                    <MenuItem Style="{StaticResource ModernMenuItem}" Header="Ganzen Katalog"
                                              ToolTip="Alle Listen des Katalogs mit Seitenzahlen drucken" Click="PrintAll_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Click="ShowActionMenu_Click" ToolTip="Aktuelle Liste oder ganzen Katalog als PDF speichern">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <svgc:SvgViewbox Width="16" Height="16" Margin="0,0,7,0"
                                                      Source="/assets/icons/pdf-icon.svg" />
                                    <TextBlock Text="Als PDF speichern ▾" />
                                </StackPanel>
                            </Button.Content>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenu}" Closed="ActionMenu_Closed">
                                    <MenuItem Style="{StaticResource ModernMenuItem}" Header="Aktuelle Liste"
                                              ToolTip="Nur die ausgewählte Liste als PDF speichern" Click="SaveCurrentAsPdf_Click" />
                                    <MenuItem Style="{StaticResource ModernMenuItem}" Header="Ganzen Katalog"
                                              ToolTip="Alle Listen des Katalogs mit Seitenzahlen als PDF speichern" Click="SaveAllAsPdf_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Click="ShowActionMenu_Click" ToolTip="Katalogdaten importieren oder exportieren und weitere Einstellungen öffnen">
                            <Button.Content>Einstellungen ▾</Button.Content>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenu}" Closed="ActionMenu_Closed">
                                    <MenuItem Style="{StaticResource ModernMenuItem}" Header="Katalog importieren"
                                              ToolTip="Gespeicherte Katalogdaten aus einer Datei laden"
                                              Click="Import_Click" />
                                    <MenuItem Style="{StaticResource ModernMenuItem}" Header="Katalog exportieren"
                                              ToolTip="Katalogdaten als Sicherungsdatei exportieren"
                                              Click="Export_Click" />
                                    <Separator />
                                    <MenuItem Style="{StaticResource ModernMenuItem}" Header="Nach Updates suchen"
                                              Click="CheckUpdates_Click" />
                                    <Separator />
                                    <MenuItem Style="{StaticResource ModernMenuItem}" Header="Auf Werkseinstellungen zurücksetzen"
                                              Foreground="#B42318" Click="ResetToFactorySettings_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#D8E0E8" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SearchBoxContainer" Width="260" Height="38"
                            Background="White" BorderBrush="#9CB6CE" BorderThickness="1"
                            CornerRadius="6" VerticalAlignment="Center">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <svgc:SvgViewbox Grid.Column="0" Width="16" Height="16"
                                              VerticalAlignment="Center" IsHitTestVisible="False"
                                              Source="/assets/icons/find-icon.svg" />
                            <Grid Grid.Column="2">
                                <TextBox x:Name="SearchBox"
                                         FocusVisualStyle="{x:Null}"
                                         VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"
                                         GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                         LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                                         PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                                         Padding="0,5" BorderThickness="0" Background="Transparent"
                                         ToolTip="Alle Kataloge und Listen durchsuchen">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    SnapsToDevicePixels="True">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden"
                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="Suchen"
                                           Foreground="#7C8B99"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Visible" />
                            </Grid>
                            <Button x:Name="ClearSearchButton" Grid.Column="3"
                                    Width="26" Height="26" MinHeight="0" Padding="0"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Foreground="#657586"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip="Suche löschen"
                                    AutomationProperties.Name="Suche löschen"
                                    Click="ClearSearchButton_Click"
                                    Visibility="Collapsed">
                                <Path Width="11" Height="11"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 2,2 L 9,9 M 9,2 L 2,9"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" Text="SQLite · automatisch gespeichert" Foreground="#56715E"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </Grid>
            </Border>
            <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=SearchBoxContainer}"
                   Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border Width="270"
                        MaxHeight="260" Margin="0,6,0,0"
                        Background="White" BorderBrush="#D8E0E8" BorderThickness="1"
                       CornerRadius="8" Padding="4">
                   <Border.Effect>
                       <DropShadowEffect Color="#18344F" BlurRadius="16" ShadowDepth="4" Opacity="0.16" />
                   </Border.Effect>
                   <ListBox x:Name="SearchResultsBox" MaxHeight="250"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.PanningMode="VerticalOnly"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            ItemContainerStyle="{StaticResource SearchResultItem}"
                            SelectionChanged="SearchResultsBox_SelectionChanged"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                       <ListBox.Resources>
                           <Style TargetType="{x:Type ScrollBar}"
                                  BasedOn="{StaticResource ModernScrollBar}" />
                       </ListBox.Resources>
                       <ListBox.ItemTemplate>
                           <DataTemplate>
                               <TextBlock Text="{Binding DisplayText}"
                                          TextWrapping="Wrap"
                                          VerticalAlignment="Top" />
                           </DataTemplate>
                       </ListBox.ItemTemplate>
                   </ListBox>
               </Border>
            </Popup>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="3*" />
                    <ColumnDefinition x:Name="PreviewSplitterColumn" Width="6" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#D8E0E8" BorderThickness="1"
                        CornerRadius="8" Padding="18" Margin="0">
                    <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CatalogHeading" Text="Katalog" FontSize="22" FontWeight="SemiBold"
                                               Foreground="#172B42" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Vorlage" Click="EditLabelLayout_Click"
                                                ToolTip="Etikettenfelder, Druckraster und Firmenlogo bearbeiten" />
                                        <Button x:Name="PreviewToggleButton" Click="TogglePreview_Click"
                                                Width="40" Height="36" Padding="8" Margin="8,0,0,0"
                                                ToolTip="Vorschau ausblenden"
                                                AutomationProperties.Name="Vorschau ausblenden">
                                            <Image x:Name="PreviewToggleIcon" Width="20" Height="20"
                                                   Source="/assets/icons/eye-closed.png" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CatalogDescription" Text="Einträge und Listen direkt in der lokalen Datenbank pflegen."
                                           Foreground="#657586" Margin="0,4,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CatalogBox" Grid.Column="0" Width="220"
                                              VerticalContentAlignment="Center"
                                              ToolTip="Katalog auswählen"
                                              SelectionChanged="CatalogBox_SelectionChanged" />
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Left"
                                               VerticalAlignment="Center">
                                        <Button Click="ShowActionMenu_Click" ToolTip="Katalog hinzufügen, umbenennen oder löschen">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <svgc:SvgViewbox Width="16" Height="16" Margin="0,0,7,0"
                                                                      Source="/assets/icons/folder-rename-icon.svg" />
                                                    <TextBlock Text="Katalog ▾" />
                                                </StackPanel>
                                            </Button.Content>
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource ModernContextMenu}" Closed="ActionMenu_Closed">
                                                    <MenuItem Style="{StaticResource CompactModernMenuItem}" Header="Hinzufügen"
                                                              ToolTip="Einen neuen Katalog anlegen"
                                                              Click="AddCatalog_Click" />
                                                    <MenuItem Style="{StaticResource CompactModernMenuItem}" Header="Umbenennen"
                                                              ToolTip="Ausgewählten Katalog umbenennen"
                                                              Click="RenameCatalog_Click" />
                                                    <Separator />
                                                    <MenuItem Style="{StaticResource CompactModernMenuItem}" Header="Löschen"
                                                              Foreground="#B42318" Click="DeleteCatalog_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="LabelPageBox" Grid.Column="0" Width="220"
                                              VerticalContentAlignment="Center"
                                              ToolTip="Liste im ausgewählten Katalog auswählen"
                                              SelectionChanged="LabelPageBox_SelectionChanged" />
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Left"
                                               VerticalAlignment="Center">
                                        <Button x:Name="LabelPageActionsButton" Click="ShowActionMenu_Click"
                                                ToolTip="Liste hinzufügen, umbenennen oder löschen">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <svgc:SvgViewbox Width="16" Height="16" Margin="0,0,7,0"
                                                                      Source="/assets/icons/folder-rename-icon.svg" />
                                                    <TextBlock Text="Liste ▾" />
                                                </StackPanel>
                                            </Button.Content>
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource ModernContextMenu}" Closed="ActionMenu_Closed">
                                                    <MenuItem Style="{StaticResource CompactModernMenuItem}" Header="Hinzufügen"
                                                              ToolTip="Eine neue Liste im Katalog anlegen"
                                                              Click="AddLabelPage_Click" />
                                                    <MenuItem Style="{StaticResource CompactModernMenuItem}" Header="Umbenennen"
                                                              ToolTip="Ausgewählte Liste umbenennen"
                                                              Click="RenameLabelPage_Click" />
                                                    <Separator />
                                                    <MenuItem Style="{StaticResource CompactModernMenuItem}" Header="Löschen"
                                                              Foreground="#B42318" Click="DeleteLabelPage_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock x:Name="LabelCountText" Foreground="#657586" Margin="4,4,0,10" />
                            </StackPanel>
                            <DataGrid x:Name="LabelGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                      DockPanel.Dock="Top"
                                      CanUserDeleteRows="False" IsReadOnly="False" SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      Sorting="LabelGrid_Sorting"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      AllowDrop="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      AlternatingRowBackground="#F7F9FB" RowHeight="38"
                                      CellEditEnding="LabelGrid_CellEditEnding"
                                      PreparingCellForEdit="LabelGrid_PreparingCellForEdit"
                                      SelectionChanged="LabelGrid_SelectionChanged"
                                      PreviewMouseLeftButtonDown="LabelGrid_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="LabelGrid_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="LabelGrid_PreviewMouseLeftButtonUp"
                                      DragOver="LabelGrid_DragOver"
                                      Drop="LabelGrid_Drop"
                                      ContextMenuOpening="LabelGrid_ContextMenuOpening">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <MenuItem x:Name="SaveItemCodeMenuItem" Style="{StaticResource ModernMenuItem}"
                                                  Header="QR-/Barcode speichern…" Click="SaveItemCode_Click" />
                                        <MenuItem x:Name="DownloadItemPhotoMenuItem" Style="{StaticResource ModernMenuItem}"
                                                  Header="Bild herunterladen…" Click="DownloadItemPhoto_Click" />
                                        <Separator />
                                        <MenuItem Style="{StaticResource ModernMenuItem}" Header="Eintrag löschen"
                                                  Foreground="#B42318" Click="DeleteLabelItem_Click" />
                                        <MenuItem Style="{StaticResource ModernMenuItem}" Header="Leeren (zurücksetzen)"
                                                  Foreground="#B42318" Click="ResetItem_Click" />
                                        <Separator />
                                        <MenuItem x:Name="MoveLabelUpMenuItem" Style="{StaticResource ModernMenuItem}" Header="Nach oben verschieben"
                                                  Click="MoveLabelUp_Click" />
                                        <MenuItem x:Name="MoveLabelDownMenuItem" Style="{StaticResource ModernMenuItem}" Header="Nach unten verschieben"
                                                  Click="MoveLabelDown_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Resources>
                                    <Style x:Key="CenteredCellText" TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                    <Style x:Key="CenteredCellEditor" TargetType="TextBox">
                                        <Setter Property="TextAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                    <Style x:Key="DescriptionCellText" TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Left" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                    <Style x:Key="DescriptionCellEditor" TargetType="TextBox">
                                        <Setter Property="TextAlignment" Value="Left" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                    <Style x:Key="PhotoPickerButton" TargetType="Button">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="#C8D5E1" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="PhotoBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="PhotoBorder" Property="BorderBrush" Value="#527FA9" />
                                                            <Setter TargetName="PhotoBorder" Property="Background" Value="#E8F1FA" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="PhotoBorder" Property="BorderBrush" Value="#244A73" />
                                                            <Setter TargetName="PhotoBorder" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell"
                                           BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1677D2" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Background" Value="#FFFFD982" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FFFFA500" BlurRadius="14"
                                                                          ShadowDepth="0" Opacity="0.9" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDragTarget}" Value="True">
                                                <Setter Property="Background" Value="#DCEBFF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDropPlaceholder}" Value="True">
                                                <Setter Property="Background" Value="#EEF3F8" />
                                                <Setter Property="Opacity" Value="0.72" />
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1677D2" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pos. ↕" Binding="{Binding PositionText}" SortMemberPath="Index"
                                                        IsReadOnly="True" Width="64"
                                                        ElementStyle="{StaticResource CenteredCellText}">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell"
                                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Setter Property="Cursor" Value="SizeAll" />
                                                <Setter Property="ToolTip" Value="Positionsnummer halten und auf eine neue Position ziehen; Vorschau und Druck werden aktualisiert" />
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                    </DockPanel>
                </Border>
                <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="#D8E0E8" ShowsPreview="True"
                              DragCompleted="PreviewSplitter_DragCompleted" />
                <Border x:Name="PreviewPanel" Grid.Column="2" Background="#E8EEF4" CornerRadius="8"
                        BorderBrush="#D8E0E8" BorderThickness="1" Padding="12" Margin="6,6,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                            <StackPanel>
                                <TextBlock Text="Druckvorschau" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#172B42" />
                                <TextBlock x:Name="PreviewDescription" Text="A4 · tatsächliches Drucklayout"
                                           Foreground="#657586" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <DocumentViewer x:Name="PrintPreviewViewer" Background="#E8EEF4"
                                        Loaded="PrintPreviewViewer_Loaded"
                                        PreviewMouseWheel="PrintPreviewViewer_PreviewMouseWheel" />
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#E8EEF4" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gespeichert auf diesem Computer" Foreground="#43576A" />
                    <TextBlock x:Name="DatabasePathText" Grid.Column="1" Foreground="#657586"
                               Margin="14,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AppVersionText" Grid.Column="2" Foreground="#657586" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
