<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FuniturenEditor_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FuniturenEditor_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid x:Name="AuthenticationView" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Border
                Width="440"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="16">
                    <FontIcon
                        Glyph="&#xE7C1;"
                        FontSize="34"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="AuthenticationTitle"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="Furnituren Editor" />
                    <TextBlock
                        x:Name="AuthenticationSubtitle"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="Melde dich an, um deinen lokalen Katalog zu öffnen."
                        TextWrapping="Wrap" />
                    <TextBlock Text="Benutzername" />
                    <TextBox
                        x:Name="UsernameBox"
                        AutomationProperties.AutomationId="AuthUsername"
                        PlaceholderText="Benutzername"
                        KeyDown="Authentication_KeyDown" />
                    <TextBlock Text="Passwort" />
                    <PasswordBox
                        x:Name="PasswordInput"
                        AutomationProperties.AutomationId="AuthPassword"
                        PlaceholderText="Passwort"
                        PasswordChanged="PasswordInput_PasswordChanged"
                        KeyDown="Authentication_KeyDown" />
                    <StackPanel x:Name="PasswordStrengthPanel" Spacing="5" Visibility="Collapsed">
                        <Grid Height="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="StrengthSegment1"
                                Margin="0,0,3,0"
                                Background="#D8E0E8"
                                CornerRadius="3" />
                            <Border
                                x:Name="StrengthSegment2"
                                Grid.Column="1"
                                Margin="2,0"
                                Background="#D8E0E8"
                                CornerRadius="3" />
                            <Border
                                x:Name="StrengthSegment3"
                                Grid.Column="2"
                                Margin="3,0,0,0"
                                Background="#D8E0E8"
                                CornerRadius="3" />
                        </Grid>
                        <TextBlock
                            x:Name="PasswordStrengthText"
                            FontSize="12"
                            Text="Kein Passwort" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Jedes Passwort ist erlaubt. Die Anzeige ist nur ein Hinweis." />
                    </StackPanel>
                    <TextBlock
                        x:Name="PasswordConfirmLabel"
                        Text="Passwort bestätigen"
                        Visibility="Collapsed" />
                    <PasswordBox
                        x:Name="PasswordConfirmInput"
                        AutomationProperties.AutomationId="AuthPasswordConfirm"
                        PlaceholderText="Passwort wiederholen"
                        Visibility="Collapsed"
                        KeyDown="Authentication_KeyDown" />
                    <InfoBar
                        x:Name="AuthenticationInfoBar"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Error" />
                    <Button
                        x:Name="AuthenticationButton"
                        AutomationProperties.AutomationId="AuthSubmit"
                        HorizontalAlignment="Stretch"
                        Click="AuthenticationButton_Click"
                        Content="Anmelden"
                        Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Deine Daten bleiben auf diesem Computer."
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            AutomationProperties.AutomationId="AppNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Left"
            SelectionChanged="ShellNavigation_SelectionChanged"
            Visibility="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavFurniture"
                    Content="Furnituren"
                    Icon="Home"
                    Tag="furniture" />
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavEmployees"
                    Content="Mitarbeitende"
                    Icon="People"
                    Tag="employees" />
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavPrintLayout"
                    Content="Drucklayout"
                    Icon="Page"
                    Tag="layout" />
                <NavigationViewItem
                    x:Name="UsersNavigationItem"
                    AutomationProperties.AutomationId="NavUsers"
                    Content="Benutzer"
                    Icon="Contact"
                    Tag="users" />
            </NavigationView.MenuItems>
            <NavigationView.Header>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        x:Name="SignedInLabel"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        AutomationProperties.AutomationId="SignOut"
                        Click="SignOutButton_Click"
                        Content="Abmelden" />
                </StackPanel>
            </NavigationView.Header>
            <NavigationView.Content>
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Name="StatusInfoBar"
                        Grid.Row="0"
                        IsOpen="False"
                        IsClosable="True"
                        Margin="20,12,20,0" />
                    <Grid x:Name="FurnitureView" Grid.Row="1" Padding="28" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Furnituren" />
                                <TextBlock
                                    x:Name="FurnitureSubtitle"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Katalog und Etiketten verwalten" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="ImportCatalog"
                                    Click="ImportButton_Click"
                                    Content="Importieren" />
                                <Button
                                    AutomationProperties.AutomationId="ExportCatalog"
                                    Click="ExportButton_Click"
                                    Content="Exportieren" />
                                <Button
                                    AutomationProperties.AutomationId="PrintCatalog"
                                    Click="PrintButton_Click"
                                    Content="A4-Druck" />
                                <Button
                                    AutomationProperties.AutomationId="PrintAllCatalogs"
                                    Click="PrintAllButton_Click"
                                    Content="Alle drucken" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,20,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="CategoryBox"
                                AutomationProperties.AutomationId="FurnitureCategory"
                                Header="Kategorie"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="CategoryBox_SelectionChanged" />
                            <AutoSuggestBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="FurnitureSearch"
                                PlaceholderText="Katalog durchsuchen"
                                QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                SuggestionChosen="SearchBox_SuggestionChosen" />
                            <Button
                                Grid.Column="2"
                                AutomationProperties.AutomationId="AddCategory"
                                VerticalAlignment="Bottom"
                                Click="AddCategoryButton_Click"
                                Content="Neue Kategorie" />
                            <Button
                                Grid.Column="3"
                                AutomationProperties.AutomationId="DeleteCategory"
                                VerticalAlignment="Bottom"
                                Click="DeleteCategoryButton_Click"
                                Content="Kategorie löschen" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="300" />
                                <ColumnDefinition Width="1.15*" MinWidth="400" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="8,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="NR." />
                                        <TextBlock Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" Text="ARTIKEL" />
                                        <TextBlock Grid.Column="2" Style="{ThemeResource CaptionTextBlockStyle}" Text="PLATZ" />
                                    </Grid>
                                    <ListView
                                        x:Name="FurnitureList"
                                        Grid.Row="1"
                                        AutomationProperties.AutomationId="FurnitureItems"
                                        IsItemClickEnabled="False"
                                        SelectionChanged="FurnitureList_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:FurnitureListEntry">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="38"
                                                        Height="38"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="5">
                                                        <Image Source="{x:Bind Photo, Mode=OneTime}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind DisplayText, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="46" />
                                                <Setter Property="Padding" Value="8,4" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button
                                            AutomationProperties.AutomationId="MoveItemUp"
                                            Click="MoveUpButton_Click"
                                            ToolTipService.ToolTip="Position nach oben verschieben">
                                            <FontIcon Glyph="&#xE74A;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.AutomationId="MoveItemDown"
                                            Click="MoveDownButton_Click"
                                            ToolTipService.ToolTip="Position nach unten verschieben">
                                            <FontIcon Glyph="&#xE74B;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.AutomationId="ResetItem"
                                            Click="ResetItemButton_Click"
                                            Content="Position leeren" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid ColumnSpacing="16" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.ColumnSpan="2" Spacing="4">
                                            <TextBlock x:Name="ItemHeading" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Position auswählen" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Änderungen werden automatisch lokal gespeichert." />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <TextBlock Text="Beschreibung" />
                                            <TextBox
                                                x:Name="TitleBox"
                                                AutomationProperties.AutomationId="ItemTitle"
                                                PlaceholderText="Artikelname"
                                                TextChanged="FurnitureField_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="BECO" />
                                            <TextBox
                                                x:Name="BecoBox"
                                                AutomationProperties.AutomationId="ItemBeco"
                                                PlaceholderText="BECO-Nummer"
                                                TextChanged="FurnitureField_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="6">
                                            <TextBlock Text="Referenz / QR-Inhalt" />
                                            <TextBox
                                                x:Name="ReferenceBox"
                                                AutomationProperties.AutomationId="ItemReference"
                                                PlaceholderText="Artikelreferenz"
                                                TextChanged="FurnitureField_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Verkaufspreis" />
                                            <TextBox
                                                x:Name="PriceBox"
                                                AutomationProperties.AutomationId="ItemPrice"
                                                PlaceholderText="z. B. 499,00 €"
                                                TextChanged="FurnitureField_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Spacing="6">
                                            <TextBlock Text="Einkaufspreis" />
                                            <TextBox
                                                x:Name="EkBox"
                                                AutomationProperties.AutomationId="ItemEk"
                                                PlaceholderText="EK"
                                                TextChanged="FurnitureField_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Foto" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    AutomationProperties.AutomationId="ChooseItemPhoto"
                                                    Click="ChoosePhotoButton_Click"
                                                    Content="Foto auswählen" />
                                                <Button
                                                    AutomationProperties.AutomationId="ChooseLibraryPhoto"
                                                    Click="OpenPhotoLibraryButton_Click"
                                                    Content="Mediathek" />
                                                <Button
                                                    AutomationProperties.AutomationId="ClearItemPhoto"
                                                    Click="ClearPhotoButton_Click"
                                                    Content="Entfernen" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border
                                            Grid.Row="4"
                                            Grid.ColumnSpan="2"
                                            Height="150"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Image x:Name="PhotoPreview" Stretch="Uniform" />
                                        </Border>
                                        <CheckBox
                                            x:Name="QuickServiceCheckBox"
                                            Grid.Row="5"
                                            Grid.ColumnSpan="2"
                                            AutomationProperties.AutomationId="ItemQuickService"
                                            Content="Quick-Service-Artikel (QR-Code im Etikett)"
                                            Checked="QuickServiceCheckBox_Changed"
                                            Unchecked="QuickServiceCheckBox_Changed" />
                                        <StackPanel
                                            Grid.Row="6"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                            <NumberBox
                                                x:Name="ItemPositionBox"
                                                AutomationProperties.AutomationId="ItemPosition"
                                                Header="Position"
                                                Minimum="1"
                                                Maximum="15"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Inline"
                                                ValueChanged="ItemPosition_ValueChanged"
                                                Width="130" />
                                            <TextBlock
                                                x:Name="ItemSaveStatus"
                                                Margin="8,22,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Automatisches Speichern aktiv" />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="EmployeesView" Grid.Row="1" Padding="28" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Mitarbeitende" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Mitarbeiterlisten nach Filiale verwalten." />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,20,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="BranchBox"
                                AutomationProperties.AutomationId="EmployeeBranch"
                                Header="Filiale"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="BranchBox_SelectionChanged" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.AutomationId="AddBranch"
                                VerticalAlignment="Bottom"
                                Click="AddBranchButton_Click"
                                Content="Neue Filiale" />
                            <Button
                                Grid.Column="2"
                                AutomationProperties.AutomationId="DeleteBranch"
                                VerticalAlignment="Bottom"
                                Click="DeleteBranchButton_Click"
                                Content="Filiale löschen" />
                            <AutoSuggestBox
                                x:Name="EmployeeSearchBox"
                                Grid.Column="3"
                                AutomationProperties.AutomationId="EmployeeSearch"
                                Header="Mitarbeitende suchen"
                                PlaceholderText="Name, Nummer oder Filiale"
                                QueryIcon="Find"
                                TextChanged="EmployeeSearchBox_TextChanged"
                                QuerySubmitted="EmployeeSearchBox_QuerySubmitted"
                                SuggestionChosen="EmployeeSearchBox_SuggestionChosen" />
                            <StackPanel
                                Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="PrintEmployees"
                                    Click="PrintEmployeesButton_Click"
                                    Content="Filiale drucken" />
                                <Button
                                    AutomationProperties.AutomationId="PrintAllEmployees"
                                    Click="PrintAllEmployeesButton_Click"
                                    Content="Alle drucken" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="300" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListView
                                        x:Name="EmployeeList"
                                        AutomationProperties.AutomationId="Employees"
                                        SelectionChanged="EmployeeList_SelectionChanged" />
                                    <Button
                                        Grid.Row="1"
                                        AutomationProperties.AutomationId="AddEmployee"
                                        HorizontalAlignment="Stretch"
                                        Click="AddEmployeeButton_Click"
                                        Content="Mitarbeiter hinzufügen" />
                                </Grid>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Mitarbeiterdetails" />
                                        <TextBlock Text="Name" />
                                        <TextBox
                                            x:Name="EmployeeNameBox"
                                            AutomationProperties.AutomationId="EmployeeName"
                                            PlaceholderText="Vor- und Nachname"
                                            TextChanged="EmployeeField_TextChanged" />
                                        <TextBlock Text="Personalnummer" />
                                        <TextBox
                                            x:Name="EmployeeNumberBox"
                                            AutomationProperties.AutomationId="EmployeeNumber"
                                            PlaceholderText="Nummer"
                                            TextChanged="EmployeeField_TextChanged" />
                                        <TextBlock Text="Code für QR-Karte" />
                                        <TextBox
                                            x:Name="EmployeeCodeBox"
                                            AutomationProperties.AutomationId="EmployeeCode"
                                            PlaceholderText="z. B. Anmeldecode"
                                            TextChanged="EmployeeField_TextChanged" />
                                        <Button
                                            AutomationProperties.AutomationId="DeleteEmployee"
                                            HorizontalAlignment="Left"
                                            Click="DeleteEmployeeButton_Click"
                                            Content="Mitarbeiter löschen" />
                                        <TextBlock Margin="0,8,0,0" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Kartenlayout" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                x:Name="EmployeeCardWidthBox"
                                                AutomationProperties.AutomationId="EmployeeCardWidth"
                                                Header="Breite (mm)"
                                                Minimum="35"
                                                Maximum="180"
                                                SmallChange="1"
                                                ValueChanged="EmployeeLayout_ValueChanged" />
                                            <NumberBox
                                                x:Name="EmployeeCardHeightBox"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="EmployeeCardHeight"
                                                Header="Höhe (mm)"
                                                Minimum="12"
                                                Maximum="80"
                                                SmallChange="1"
                                                ValueChanged="EmployeeLayout_ValueChanged" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                x:Name="EmployeeNameSizeBox"
                                                AutomationProperties.AutomationId="EmployeeNameSize"
                                                Header="Namensgröße (pt)"
                                                Minimum="4"
                                                Maximum="24"
                                                SmallChange="0.5"
                                                ValueChanged="EmployeeLayout_ValueChanged" />
                                            <NumberBox
                                                x:Name="EmployeeNumberSizeBox"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="EmployeeNumberSize"
                                                Header="Nummerngröße (pt)"
                                                Minimum="4"
                                                Maximum="24"
                                                SmallChange="0.5"
                                                ValueChanged="EmployeeLayout_ValueChanged" />
                                        </Grid>
                                        <ComboBox
                                            x:Name="EmployeeQrPositionBox"
                                            AutomationProperties.AutomationId="EmployeeQrPosition"
                                            Header="QR-Code-Position"
                                            SelectionChanged="EmployeeQrPosition_SelectionChanged" />
                                        <CheckBox
                                            x:Name="EmployeeNameBoldBox"
                                            AutomationProperties.AutomationId="EmployeeNameBold"
                                            Content="Name fett"
                                            Checked="EmployeeNameBold_Changed"
                                            Unchecked="EmployeeNameBold_Changed" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="LayoutView" Grid.Row="1" Padding="28" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Drucklayout" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Etikettengröße und Positionen für den A4-Druck konfigurieren." />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,18,0,18" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="CellWidthBox"
                                AutomationProperties.AutomationId="LabelWidth"
                                Header="Etikettbreite (cm)"
                                Minimum="2"
                                Maximum="5"
                                SmallChange="0.1"
                                Value="3.5"
                                ValueChanged="LayoutField_ValueChanged" />
                            <NumberBox
                                x:Name="CellHeightBox"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="LabelHeight"
                                Header="Etiketthöhe (cm)"
                                Minimum="2"
                                Maximum="5"
                                SmallChange="0.1"
                                Value="3.5"
                                ValueChanged="LayoutField_ValueChanged" />
                            <ComboBox
                                x:Name="LayoutElementBox"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="LayoutElement"
                                Header="Layout-Element"
                                SelectionChanged="LayoutElementBox_SelectionChanged" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid ColumnSpacing="14" RowSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox x:Name="ElementXBox" AutomationProperties.AutomationId="LayoutX" Header="X (cm)" Minimum="0" SmallChange="0.1" ValueChanged="LayoutField_ValueChanged" />
                                    <NumberBox x:Name="ElementYBox" Grid.Column="1" AutomationProperties.AutomationId="LayoutY" Header="Y (cm)" Minimum="0" SmallChange="0.1" ValueChanged="LayoutField_ValueChanged" />
                                    <NumberBox x:Name="ElementWidthBox" Grid.Row="1" AutomationProperties.AutomationId="LayoutElementWidth" Header="Breite (cm)" Minimum="0" SmallChange="0.1" ValueChanged="LayoutField_ValueChanged" />
                                    <NumberBox x:Name="ElementHeightBox" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="LayoutElementHeight" Header="Höhe (cm)" Minimum="0" SmallChange="0.1" ValueChanged="LayoutField_ValueChanged" />
                                    <NumberBox x:Name="ElementFontSizeBox" Grid.Row="2" AutomationProperties.AutomationId="LayoutFontSize" Header="Schriftgröße (pt)" Minimum="4" Maximum="24" SmallChange="1" ValueChanged="LayoutField_ValueChanged" />
                                    <CheckBox
                                        x:Name="ElementBoldCheckBox"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="LayoutBold"
                                        VerticalAlignment="Bottom"
                                        Content="Fett"
                                        Checked="LayoutBoldCheckBox_Changed"
                                        Unchecked="LayoutBoldCheckBox_Changed" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Koordinaten werden innerhalb des Etiketts gemessen. A4-Seite: 5 × 3 Etiketten, Querformat." />
                                    <Button
                                        Grid.Row="4"
                                        Grid.ColumnSpan="2"
                                        AutomationProperties.AutomationId="ExportQuickServiceQr"
                                        HorizontalAlignment="Stretch"
                                        Click="QuickServiceQrButton_Click"
                                        Content="Quick-Service-QR-Codes als ZIP exportieren" />
                                    <Button
                                        Grid.Row="5"
                                        Grid.ColumnSpan="2"
                                        AutomationProperties.AutomationId="PrintCurrentCategory"
                                        HorizontalAlignment="Stretch"
                                        Click="PrintButton_Click"
                                        Content="Aktuelle Kategorie in der A4-Vorschau öffnen" />
                                </Grid>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="24"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Druckvorschau in der App" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Die Vorschau bleibt in der App. Öffne von dort den Windows-Druckdialog und kontrolliere Papierformat, Ausrichtung und Maßstab."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="UsersView" Grid.Row="1" Padding="28" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Benutzerverwaltung" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Lokale Konten mit geschütztem Passwort verwalten." />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,20,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NewUsernameBox"
                                AutomationProperties.AutomationId="NewUsername"
                                Header="Neuer Benutzername"
                                PlaceholderText="Benutzername" />
                            <PasswordBox
                                x:Name="NewPasswordBox"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="NewPassword"
                                Header="Passwort"
                                PlaceholderText="Passwort" />
                            <Button
                                Grid.Column="2"
                                AutomationProperties.AutomationId="CreateUser"
                                VerticalAlignment="Bottom"
                                Click="CreateUserButton_Click"
                                Content="Benutzer anlegen"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                        <Grid Grid.Row="2" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView
                                x:Name="UsersList"
                                AutomationProperties.AutomationId="UsersList"
                                SelectionChanged="UsersList_SelectionChanged" />
                            <Button
                                Grid.Row="1"
                                AutomationProperties.AutomationId="DeleteUser"
                                HorizontalAlignment="Left"
                                Click="DeleteUserButton_Click"
                                Content="Ausgewählten Benutzer löschen" />
                        </Grid>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Page>
